    "onb.location.body" : {
      "comment" : "Location permission screen, explanation",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get exact sun times where you are. Your location never leaves your watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour calculer l’heure exacte du soleil ici. Votre position ne quitte jamais la montre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para calcular la hora exacta del sol donde estás. Tu ubicación nunca sale del reloj."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para calcular la hora exacta del sol donde estás. Tu ubicación nunca sale del reloj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para calcular a hora exata do sol onde está. A sua localização nunca sai do relógio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para calcular o horário exato do sol onde você está. Sua localização nunca sai do relógio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per calcolare l’orario esatto del sole dove ti trovi. La tua posizione non lascia mai l’orologio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de exacte tijden van de zon te berekenen waar je bent. Je locatie verlaat nooit je horloge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die genauen Sonnenzeiten an deinem Ort zu berechnen. Dein Standort verlässt nie deine Uhr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の日の出・日の入りを正確に計算します。位置情報が時計の外に出ることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于计算你所在地的准确日出日落时间。位置信息绝不会离开你的手表。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحساب أوقات الشمس بدقة حيث أنت. لا يغادر موقعك ساعتك أبدًا."
          }
        }
      }
    },
